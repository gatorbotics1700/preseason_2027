package frc.robot.commands;

import edu.wpi.first.wpilibj2.command.Command;
import frc.robot.subsystems.ElevatorSubsystem;

public class ElevatorCommand extends Command {
    
    private ElevatorSubsystem elevatorSubsystem;
    private double target;

    private static final double POSITION_TOLERANCE = 0.5;

    public ElevatorCommand(double targetPosition, ElevatorSubsystem elevatorSubsystem) {
        this.elevatorSubsystem = elevatorSubsystem;
        this.targetPosition = targetPosition;
        addRequirements(elevatorSubsystem);
        System.out.println("elevator command initialized")
    }

    @Override
    public void initialize(){
       elevatorSubsystem.setTargetPosition(targetPosition);
    }
    
    @Override
    public void execute() {
        System.out.println("executing...");
    }

    @Override
    public boolean isFinished(){
        return elevatorSubsystem.atTarget(targetPosition, POSITION_TOLERANCE);
    }
}